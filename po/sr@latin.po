#: src/apprt/gtk/ui/1.3/debug-warning.blp:6
msgid ""
"⚠️ You're running a debug build of Ghostty! Performance will be degraded."
msgstr ""
"⚠️ Pokrećeš izdanje Ghostty-ja za otklanjanje grešaka! Performanse biće "
"smanjene."

