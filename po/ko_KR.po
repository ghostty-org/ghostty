msgid "Change Terminal Title"
msgstr "터미널 제목 변경"

#: src/apprt/gtk/class/title_dialog.zig:228
msgid "Change Tab Title"
msgstr "탭 제목 변경"

#: src/apprt/gtk/class/title_dialog.zig:229
msgid "Change Window Title"
msgstr "창 제목 변경"

