msgstr "Kommandot lyckades"

#: src/apprt/gtk/class/surface.zig:1208
#: src/apprt/gtk/class/surface_child_exited.zig:106
msgid "Command Failed"
msgstr "Kommandot misslyckades"

#: src/apprt/gtk/class/title_dialog.zig:226
msgid "Change Terminal Title"
msgstr "Ändra terminalens titel"

#: src/apprt/gtk/class/title_dialog.zig:227
msgid "Change Tab Title"
msgstr "Ändra flikens titel"

#: src/apprt/gtk/class/title_dialog.zig:228
