msgid ""
"Copy the screen contents to a temporary file and copy the path to the "
"clipboard."
msgstr "Kopiera skärminnehållet till en temporär fil och kopiera sökvägen till urklipp."

#: src/input/command.zig:291
msgid "Copy Screen to Temporary File and Paste Path"
msgstr "Kopiera skärmen till temporär fil och klistra in sökvägen"

