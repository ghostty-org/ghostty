From 150359fbce5278fe067455e17e1acc7340ae147b Mon Sep 17 00:00:00 2001
From: Ethan Lee <ethantlee21@gmail.com>
Date: Mon, 19 Oct 2026 12:05:37 -0400
Subject: [PATCH] input: add selection motions for a keyboard copy mode

A keyboard copy mode needs a cursor over the scrollback. The selection
can be that cursor: its end is the head, its start is the anchor, and a
one-cell selection draws as a block. What was missing is a way to start
a selection from the keyboard and to move its head the way an editor
moves a cursor. adjust_selection cannot do it: it needs a selection that
the mouse made, it only grows the selection, and it skips blank cells.

New binding actions, all surface scoped:

  start_selection          one cell at the terminal cursor, if none
  move_selection:<motion>  move the head, anchor follows (normal mode)
  extend_selection:<motion> move the head, anchor stays (select mode)
  collapse_selection       anchor onto head
  flip_selection           swap anchor and head
  select_line              whole rows, then one more row (Helix x)
  clear_selection

The motions are left, right, up, down, word_next, word_end, word_prev,
line_start, line_end, page_up, page_down, half_page_up, half_page_down,
top and bottom. The word motions follow Helix: w, e and b. A word is a
run of cells that are all in selection-word-chars or all not. Blanks and
the end of a row that does not wrap separate words.

The motion arithmetic is Selection.move and Selection.expandToLines,
with tests. The Surface handlers hold the renderer mutex, make the
selection at the cursor when there is none, and scroll the viewport
after the head the way adjust_selection does.
---
 src/Surface.zig            | 116 +++++++++
 src/input/Binding.zig      | 114 +++++++++
 src/input/command.zig      |  11 +
 src/terminal/Selection.zig | 592 +++++++++++++++++++++++++++++++++++++++++++++
 4 files changed, 833 insertions(+)

diff --git a/src/Surface.zig b/src/Surface.zig
index f6fcd853d..b59d5750e 100644
--- a/src/Surface.zig
+++ b/src/Surface.zig
@@ -5999,11 +5999,127 @@ pub fn performBindingAction(self: *Surface, action: input.Binding.Action) !bool
             screen.dirty.selection = true;
             try self.queueRender();
         },
+
+        .start_selection => {
+            self.renderer_state.mutex.lockUncancelable(global.io());
+            defer self.renderer_state.mutex.unlock(global.io());
+
+            if (try self.selectCursorIfNone()) try self.queueRender();
+        },
+
+        .move_selection => |motion| try self.moveSelection(motion, false),
+        .extend_selection => |motion| try self.moveSelection(motion, true),
+
+        .collapse_selection => {
+            self.renderer_state.mutex.lockUncancelable(global.io());
+            defer self.renderer_state.mutex.unlock(global.io());
+
+            const screen: *terminal.Screen = self.io.terminal.screens.active;
+            const sel = if (screen.selection) |*sel| sel else return false;
+            sel.startPtr().* = sel.end();
+            screen.dirty.selection = true;
+            try self.queueRender();
+        },
+
+        .flip_selection => {
+            self.renderer_state.mutex.lockUncancelable(global.io());
+            defer self.renderer_state.mutex.unlock(global.io());
+
+            const screen: *terminal.Screen = self.io.terminal.screens.active;
+            const sel = if (screen.selection) |*sel| sel else return false;
+            const anchor = sel.start();
+            sel.startPtr().* = sel.end();
+            sel.endPtr().* = anchor;
+            screen.dirty.selection = true;
+            try self.queueRender();
+        },
+
+        .select_line => {
+            self.renderer_state.mutex.lockUncancelable(global.io());
+            defer self.renderer_state.mutex.unlock(global.io());
+
+            _ = try self.selectCursorIfNone();
+            const screen: *terminal.Screen = self.io.terminal.screens.active;
+            const sel = if (screen.selection) |*sel| sel else return false;
+            sel.expandToLines(screen);
+            scrollToSelectionHead(screen, sel);
+            screen.dirty.selection = true;
+            try self.queueRender();
+        },
+
+        .clear_selection => {
+            self.renderer_state.mutex.lockUncancelable(global.io());
+            defer self.renderer_state.mutex.unlock(global.io());
+
+            if (self.io.terminal.screens.active.selection == null) return false;
+            try self.setSelection(null);
+            try self.queueRender();
+        },
     }
 
     return true;
 }
 
+/// Give the active screen a one-cell selection at the terminal cursor if it
+/// has none. Returns true if it made one. The renderer mutex must be held.
+fn selectCursorIfNone(self: *Surface) !bool {
+    const screen: *terminal.Screen = self.io.terminal.screens.active;
+    if (screen.selection != null) return false;
+    const pin = screen.cursor.page_pin.*;
+    try self.setSelection(terminal.Selection.init(pin, pin, false));
+    return true;
+}
+
+/// `move_selection` and `extend_selection`: see `terminal.Selection.move`.
+fn moveSelection(
+    self: *Surface,
+    motion: input.Binding.Action.SelectionMotion,
+    extend: bool,
+) !void {
+    self.renderer_state.mutex.lockUncancelable(global.io());
+    defer self.renderer_state.mutex.unlock(global.io());
+
+    _ = try self.selectCursorIfNone();
+    const screen: *terminal.Screen = self.io.terminal.screens.active;
+    const sel = if (screen.selection) |*sel| sel else return;
+    sel.move(screen, switch (motion) {
+        .left => .left,
+        .right => .right,
+        .up => .up,
+        .down => .down,
+        .word_next => .word_next,
+        .word_end => .word_end,
+        .word_prev => .word_prev,
+        .line_start => .line_start,
+        .line_end => .line_end,
+        .page_up => .page_up,
+        .page_down => .page_down,
+        .half_page_up => .half_page_up,
+        .half_page_down => .half_page_down,
+        .top => .top,
+        .bottom => .bottom,
+    }, extend, self.config.selection_word_chars);
+    scrollToSelectionHead(screen, sel);
+    screen.dirty.selection = true;
+    try self.queueRender();
+}
+
+/// Scroll the viewport so the selection head (`end`) is in it, the way
+/// `adjust_selection` follows its end. The renderer mutex must be held.
+fn scrollToSelectionHead(screen: *terminal.Screen, sel: *terminal.Selection) void {
+    const viewport_tl = screen.pages.getTopLeft(.viewport);
+    const viewport_br = screen.pages.getBottomRight(.viewport).?;
+    if (sel.end().isBetween(viewport_tl, viewport_br)) return;
+
+    // A head above the viewport goes to its top row, a head below it to
+    // its bottom row.
+    const target = if (sel.end().before(viewport_tl))
+        sel.end()
+    else
+        sel.end().up(screen.pages.rows - 1) orelse sel.end();
+    screen.scroll(.{ .pin = target });
+}
+
 /// Returns true if performing the given action result in closing
 /// the surface. This is used to determine if our self pointer is
 /// still valid after performing some binding action.
