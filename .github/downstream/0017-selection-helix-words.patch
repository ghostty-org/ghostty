From b0a37a6642573eb3f5d8237dd0bcac973facdf2c Mon Sep 17 00:00:00 2001
From: Ethan Lee <ethantlee21@gmail.com>
Date: Wed, 21 Oct 2026 11:19:49 -0400
Subject: [PATCH] input: select what a Helix word motion moves over, as Helix
 does

The Helix keymap of a copy mode built w, e and b from collapse_selection
and extend_selection. That kept the old head cell in the new selection,
so a b from the start of a word selected one cell too many, and a w
walked to the end of the row when the next word was on the next row.

Now select_word:<next|end|prev> is the range_to_target of Helix over
cells: the anchor steps off the cursor when the cursor is already on a
boundary, line ends after the cursor are skipped and left out, and the
head stops where the cursor of Helix stops. The word motions of
move_selection and extend_selection take their head from the same walk,
so a select-mode w lands where a normal-mode w does. The cells after the
last text of a row are a line end, so a cursor that a click put there
walks on as a cursor on a newline does in Helix.
---
 src/Surface.zig            |  22 ++
 src/input/Binding.zig      |  40 +++-
 src/input/command.zig      |   1 +
 src/terminal/Selection.zig | 471 ++++++++++++++++++++++++++-----------
 4 files changed, 400 insertions(+), 134 deletions(-)

diff --git a/src/Surface.zig b/src/Surface.zig
index c4f5ad9d0..318b5bdb1 100644
--- a/src/Surface.zig
+++ b/src/Surface.zig
@@ -6022,6 +6022,7 @@ pub fn performBindingAction(self: *Surface, action: input.Binding.Action) !bool
 
         .move_selection => |motion| try self.moveSelection(motion, false),
         .extend_selection => |motion| try self.moveSelection(motion, true),
+        .select_word => |motion| try self.selectWord(motion),
 
         .collapse_selection => {
             self.renderer_state.mutex.lockUncancelable(global.io());
@@ -6160,6 +6161,27 @@ fn moveSelection(
     try self.queueRender();
 }
 
+/// `select_word`: see `terminal.Selection.selectWord`.
+fn selectWord(
+    self: *Surface,
+    motion: input.Binding.Action.SelectionWordMotion,
+) !void {
+    self.renderer_state.mutex.lockUncancelable(global.io());
+    defer self.renderer_state.mutex.unlock(global.io());
+
+    _ = try self.selectCursorIfNone();
+    const screen: *terminal.Screen = self.io.terminal.screens.active;
+    const sel = if (screen.selection) |*sel| sel else return;
+    sel.selectWord(switch (motion) {
+        .next => .next,
+        .end => .end,
+        .prev => .prev,
+    }, self.config.selection_word_chars);
+    scrollToSelectionHead(screen, sel);
+    screen.dirty.selection = true;
+    try self.queueRender();
+}
+
 /// Scroll the viewport so the selection head (`end`) is in it, the way
 /// `adjust_selection` follows its end. The renderer mutex must be held.
