 src/input/Binding.zig      |  39 +++++++++
 src/input/command.zig      |   2 +
 src/terminal/Selection.zig | 163 +++++++++++++++++++++++++++++++++++++
 4 files changed, 232 insertions(+)

diff --git a/src/Surface.zig b/src/Surface.zig
