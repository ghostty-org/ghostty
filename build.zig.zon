.{
    .name = .ghostty,
    .version = "1.4.1-dev",
    .paths = .{""},
    .fingerprint = 0x64407a2a0b4147e5,
    // Keep in sync with snap/snapcraft.yaml and flatpak/dependencies.yml
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        // Our higher-level C translation helper (this also helps ensure we
        // only need to maintain one external dependency point)
        .translate_c = .{ .path = "./pkg/translate-c" },
        .aro = .{
            // ziglang/arocc (via translate_c)
            //
            // Only translate_c uses aro, and Ghostty never asks for it
            // directly. We list it here with the same hash as translate_c's
            // build.zig.zon so that the generated files in deps/ use this
            // URL instead of the Codeberg git URL translate_c gives. Keep
            // the hash in sync with translate_c.
            .url = "https://deps.files.ghostty.org/aro-d0c8c4d9c55daa7ef6e40cf0f630a5b5e900989b.tar.gz",
            .hash = "aro-0.0.0-JSD1QtuBNwCASyBtNF3pqTl_W3oAJQGEVyFAtrBSE_Pa",
            .lazy = true,
        },

        // Zig libs
        .libxev = .{
            // mitchellh/libxev
            .url = "https://deps.files.ghostty.org/libxev-819ffa180ca20e31c7eded74e2e1aceb1eab557f.tar.gz",
            .hash = "libxev-0.0.0-86vtc8QQFACz0sVc7U-VDiDIgH-XfBuEY5JpABLjHNpn",
            .lazy = true,
        },
        .vaxis = .{
            // rockorager/libvaxis
            .url = "https://deps.files.ghostty.org/vaxis-0620b34e091deaa6f64608922be3814147128dfb.tar.gz",
            .hash = "vaxis-0.6.0-BWNV_LoTDQCQSGhvBbu_-fOf3I2P3TIiGaUzCDniO12E",
            .lazy = true,
        },
        .zigimg = .{
            // zigimg/zigimg (via vaxis)
            //
            // Only vaxis uses zigimg, and Ghostty never asks for it directly.
            // We list it here with the same hash as vaxis's build.zig.zon so
            // that the generated files in deps/ use this URL instead of the
            // git URL vaxis gives. Keep the hash in sync with vaxis.
            .url = "https://deps.files.ghostty.org/zigimg-734fa919fb15b7917d4eb124f53600348f4ffa30.tar.gz",
            .hash = "zigimg-0.1.0-8_eo2sBLGACBebrhQZUwRliZNSUyDn6szp99eip_6-Rw",
            .lazy = true,
        },
        .z2d = .{
            // vancluever/z2d
            .url = "https://deps.files.ghostty.org/z2d-8787d71bac42d9aab00428ccb37a4fd453418761.tar.gz",
            .hash = "z2d-0.13.2-j5P_HkkVFAAtOSQPRTS7wbZLbYs7oETRn7nUKSUwDjM_",
            .lazy = true,
        },
        .zig_objc = .{
            // mitchellh/zig-objc
            .url = "https://deps.files.ghostty.org/zig_objc-3352c12a868f8787ab71bf2ca6eab9fcfb635c52.tar.gz",
            .hash = "zig_objc-0.0.0-Ir_Sp_4tAQDXtPi51nW_jD9LOEzBvU9lofwO9Pzi6IB4",
            .lazy = true,
        },
        .zig_js = .{
            // mitchellh/zig-js
            .url = "https://deps.files.ghostty.org/zig_js-3c23860e47fdcdc5af805efb7fd0bdac5fd3e9bc.tar.gz",
            .hash = "zig_js-0.0.0-rjCAV7-GAADvMTBL7lPMuvDk7xgS9PCMIZWiOUXLZSlj",
            .lazy = true,
        },
        .uucode = .{
            // jacobsandlund/uucode
            //
            // Keep this at the commit vaxis pins. Ghostty builds vaxis with
            // -Dexternal_uucode=true, so vaxis uses this copy and never
            // fetches its own. The generated files in deps/ still list every
            // package that any build.zig.zon names. If the hashes differ,
            // they list a second uucode that no build uses.
            .url = "https://deps.files.ghostty.org/uucode-1fb73433bba5d93366c57f23ff2e9d7939746500.tar.gz",
            .hash = "uucode-0.2.0-ZZjBPm6FVgBcY-79AHV8ckQj86z0JwOyVyj89VeZrEiv",
        },
        .zig_wayland = .{
            // codeberg ifreund/zig-wayland
            .url = "https://deps.files.ghostty.org/zig_wayland-27dda01712ddf3cb46ebd93380d88b01a7c828f8.tar.gz",
            .hash = "wayland-0.7.0-dev-lQa1klz9AQB87V0pMKMdm8JvyOx32XR9FxcWnw9wh6XZ",
            .lazy = true,
        },
        .zf = .{
            // natecraddock/zf
            .url = "https://deps.files.ghostty.org/zf-87153bb86b75d21fbac897b738f316d449f5d0c9.tar.gz",
            .hash = "zf-0.11.0-OIRy8XCRAAB6FiMwIrtD6FqlagnFwpI6YyOu7bXeYH5J",
            .lazy = true,
        },
        // The three entries below are never fetched by any build. They
        // exist only for the generated files in deps/.
        //
        // zf pins an older vaxis than ours, and that vaxis pins an older
        // zigimg and uucode. Ghostty builds zf with -Dwith_tui=false, so zf
        // never asks for its vaxis and Zig never downloads any of the three.
        //
        // The generated files list every package that any build.zig.zon
        // names, whether or not a build uses it. Packages with the same
        // hash are listed once, under the URL given here. Without these
        // entries, the files would list zf's git URLs. The vaxis and zigimg
        // commits are no longer on any upstream branch, so those URLs can't
        // be fetched, and offline, Nix, and Flatpak builds would fail.
        //
        // No build script refers to these names. Remove all three once zf
        // pins the same vaxis hash as the `vaxis` entry above.
        .zf_vaxis = .{
            // rockorager/libvaxis (via zf)
            .url = "https://deps.files.ghostty.org/vaxis-6fd944a27fb3d6f596e981076381a3131f2448b4.tar.gz",
            .hash = "vaxis-0.6.0-BWNV_MafDAAEzkVUvrW9NFUqnnMUoeHqrs2mecnD6D7w",
            .lazy = true,
        },
        .zf_vaxis_zigimg = .{
            // sergot/zigimg (via zf's vaxis)
            .url = "https://deps.files.ghostty.org/zigimg-c701c9f99779d7ddf594dcc6da8f858fd277d61f.tar.gz",
            .hash = "zigimg-0.1.0-8_eo2ri_FwBqF5UYiggLz4IGjHJO_n9-B6gT9Ayqg8G4",
            .lazy = true,
        },
        .zf_vaxis_uucode = .{
            // jacobsandlund/uucode (via zf's vaxis)
            .url = "https://deps.files.ghostty.org/uucode-ea62149739404a73c202b48a33bf6dd2af4bd9b0.tar.gz",
            .hash = "uucode-0.2.0-ZZjBPoGFVgCiflJNFc6Io8xzC67B6PA5bUkk4LT0kCxg",
            .lazy = true,
        },
        .gobject = .{
            // https://github.com/ghostty-org/zig-gobject based on zig_gobject
            // Temporary until we generate them at build time automatically.
            .url = "https://deps.files.ghostty.org/gobject-2026-10-02-38-1.tar.zst",
            .hash = "gobject-0.3.2-Skun7LuIogBbEh-6WrLeEzMaRCnOMB3eOf__RaPYSMCZ",
            .lazy = true,
        },

        // C libs
        .dcimgui = .{ .path = "./pkg/dcimgui", .lazy = true },
        .fontconfig = .{ .path = "./pkg/fontconfig", .lazy = true },
        .freetype = .{ .path = "./pkg/freetype", .lazy = true },
        .gtk4_layer_shell = .{ .path = "./pkg/gtk4-layer-shell", .lazy = true },
        .harfbuzz = .{ .path = "./pkg/harfbuzz", .lazy = true },
        .highway = .{ .path = "./pkg/highway", .lazy = true },
        .libintl = .{ .path = "./pkg/libintl", .lazy = true },
        .libpng = .{ .path = "./pkg/libpng", .lazy = true },
        .macos = .{ .path = "./pkg/macos", .lazy = true },
        .oniguruma = .{ .path = "./pkg/oniguruma", .lazy = true },
        .opengl = .{ .path = "./pkg/opengl", .lazy = true },
        .sentry = .{ .path = "./pkg/sentry", .lazy = true },
        .simdutf = .{ .path = "./pkg/simdutf", .lazy = true },
        .wuffs = .{ .path = "./pkg/wuffs", .lazy = true },
        .zlib = .{ .path = "./pkg/zlib", .lazy = true },

        // Shader translation
        .glslang = .{ .path = "./pkg/glslang", .lazy = true },
        .spirv_cross = .{ .path = "./pkg/spirv-cross", .lazy = true },

        // Wayland
        .wayland = .{
            .url = "https://deps.files.ghostty.org/wayland-9cb3d7aa9dc995ffafdbdef7ab86a949d0fb0e7d.tar.gz",
            .hash = "N-V-__8AAKrHGAAs2shYq8UkE6bGcR1QJtLTyOE_lcosMn6t",
            .lazy = true,
        },
        .wayland_protocols = .{
            .url = "https://deps.files.ghostty.org/N-V-__8AAFdWDwA0ktbNUi9pFBHCRN4weXIgIfCrVjfGxqgA.tar.gz",
            .hash = "N-V-__8AAFdWDwA0ktbNUi9pFBHCRN4weXIgIfCrVjfGxqgA",
            .lazy = true,
        },
        .plasma_wayland_protocols = .{
            .url = "https://deps.files.ghostty.org/plasma_wayland_protocols-12207e0851c12acdeee0991e893e0132fc87bb763969a585dc16ecca33e88334c566.tar.gz",
            .hash = "N-V-__8AAKYZBAB-CFHBKs3u4JkeiT4BMvyHu3Y5aaWF3Bbs",
            .lazy = true,
        },

        // Fonts
        .jetbrains_mono = .{
            .url = "https://deps.files.ghostty.org/JetBrainsMono-2.304.tar.gz",
            .hash = "N-V-__8AAIC5lwAVPJJzxnCAahSvZTIlG-HhtOvnM1uh-66x",
            .lazy = true,
        },
        .nerd_fonts_symbols_only = .{
            .url = "https://deps.files.ghostty.org/NerdFontsSymbolsOnly-3.4.0.tar.gz",
            .hash = "N-V-__8AAMVLTABmYkLqhZPLXnMl-KyN38R8UVYqGrxqO26s",
            .lazy = true,
        },

        // Other
        .apple_sdk = .{ .path = "./pkg/apple-sdk" },
        .android_ndk = .{ .path = "./pkg/android-ndk" },
        .iterm2_themes = .{
            .url = "https://deps.files.ghostty.org/ghostty-themes-release-20261026-153024-27cbbb5.tgz",
            .hash = "N-V-__8AAIs9BgCF_swp81fS2tAWIJytW8NCUa6EbSOygPE3",
            .lazy = true,
        },
    },
    // The license and version of the third-party code above, for
    // packagers. Zig ignores this field. See src/build/LibVtPackages.zig.
    .third_party = .{
        .{ .name = "iterm2_themes", .license = "MIT" },
        .{ .name = "uucode", .license = "MIT AND Unicode-3.0" },
        .{ .name = "zigimg", .license = "MIT" },
    },
}
