#!/bin/bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/common.sh"

usage() {
    cat <<'EOF'
Usage: omg-vm COMMAND

Commands:
  up                 Start the retained VM headless and wait for its GUI session
  status             Show Tart state and guest IP
  deploy [APP]       Deploy this checkout's Debug OMG.app to the guest
  run                Launch OMG Dev in the guest Aqua session
  shot [OUTPUT.png]  Capture the guest display without opening a host window
  provision          Grant the guest Accessibility/ScreenCapture/Automation for smoke tests
  display [MODE]     List or set the guest display resolution (e.g. 1512x982)
  smoke [OUTPUT.png] Run the guest keyboard/PTY/screenshot smoke check
  desktop            Exercise real mouse drag, native fullscreen and latency benchmarks
  xctest [OPTIONS]   Build on the host and run GhosttyTests inside the guest VM
  logs               Show the Tart and OMG guest logs
  down               Shut the guest down gracefully while retaining its disk

Environment:
  OMG_VM_NAME        Tart VM name (default: omg-test)
  OMG_VM_USER        Guest user (default: admin)
  OMG_VM_APP         Debug app path (default: macos/build/Debug/OMG.app)
  OMG_VM_STATE       Host key/log directory (default: ~/.local/share/omg-vm)
EOF
}

vm_up() {
    local state attempt git_common
    state="$(omg_vm_state)"
    [[ -n "$state" ]] || omg_vm_die "VM '$OMG_VM_NAME' does not exist; see macos/VM_TESTING.md"

    git_common="$(cd "$OMG_VM_REPO_ROOT" && git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"

    if [[ "$state" == suspended ]]; then
        "$OMG_TART" stop "$OMG_VM_NAME"
        state=stopped
    fi

    if [[ "$state" == running ]]; then
        if ! omg_vm_ssh "test -d '/Volumes/My Shared Files/repo'" 2>/dev/null ||
            { [[ -d /Applications/Xcode.app ]] && ! omg_vm_ssh "test -d '/Volumes/My Shared Files/Xcode.app'" 2>/dev/null; }; then
            vm_down
            state=stopped
        fi
    fi

    if [[ "$state" != running ]]; then
        local -a share_args=(--dir="repo:$OMG_VM_REPO_ROOT")
        if [[ -d /Applications/Xcode.app ]]; then
            share_args+=(--dir="Xcode.app:/Applications/Xcode.app:ro")
        fi
        if [[ -n "$git_common" && "$git_common" != "$OMG_VM_REPO_ROOT/.git" && -d "$git_common" ]]; then
            share_args+=(--dir="gitcommon:$git_common")
        fi
        launchctl remove "$OMG_VM_LABEL" 2>/dev/null || true
        : >"$OMG_VM_LOG"
        launchctl submit -l "$OMG_VM_LABEL" \
            -o "$OMG_VM_LOG" -e "$OMG_VM_LOG" \
            -- "$OMG_TART" run --no-graphics "${share_args[@]}" "$OMG_VM_NAME"

        for attempt in $(seq 1 120); do
            state="$(omg_vm_state)"
            [[ "$state" == running ]] && break
            if ! launchctl print "gui/$(id -u)/$OMG_VM_LABEL" >/dev/null 2>&1; then
                tail -20 "$OMG_VM_LOG" >&2 || true
                omg_vm_die "Tart exited before the VM started"
            fi
            sleep 1
        done
        [[ "$state" == running ]] || omg_vm_die "timed out starting VM; see $OMG_VM_LOG"
    fi

    omg_vm_install_ssh_key
    omg_vm_wait_for_ssh
    omg_vm_wait_for_gui
    if omg_vm_ssh "test -d '/Volumes/My Shared Files/repo'"; then
        omg_vm_ssh "sudo -n mkdir -p '$(dirname "$OMG_VM_REPO_ROOT")' && sudo -n ln -sfn '/Volumes/My Shared Files/repo' '$OMG_VM_REPO_ROOT'"
    fi
    if [[ -n "$git_common" && "$git_common" != "$OMG_VM_REPO_ROOT/.git" ]] &&
        omg_vm_ssh "test -d '/Volumes/My Shared Files/gitcommon'"; then
        omg_vm_ssh "sudo -n mkdir -p '$(dirname "$git_common")' && sudo -n ln -sfn '/Volumes/My Shared Files/gitcommon' '$git_common'"
    fi
    if [[ -f "$OMG_VM_DISPLAY_FILE" ]]; then
        vm_display "$(cat "$OMG_VM_DISPLAY_FILE")"
    fi
    printf 'VM %s is running at %s\n' "$OMG_VM_NAME" "$(omg_vm_ip)"
}

vm_status() {
    local state
    state="$(omg_vm_state)"
    [[ -n "$state" ]] || omg_vm_die "VM '$OMG_VM_NAME' does not exist"
    printf 'VM: %s\nState: %s\n' "$OMG_VM_NAME" "$state"
    if [[ "$state" == running ]]; then
        printf 'Guest IP: %s\n' "$(omg_vm_ip)"
    fi
}

vm_deploy() {
    local app ip
    app="${1:-$OMG_VM_APP}"
    OMG_VM_APP="$app"
    omg_vm_require_debug_app
    omg_vm_require_running

    ip="$(omg_vm_ip)"
    omg_vm_ssh "mkdir -p /tmp/OMG.app.stage"
    rsync -a --delete -e "ssh ${OMG_VM_SSH_OPTS[*]}" \
        "$OMG_VM_APP/" "$OMG_VM_USER@$ip:/tmp/OMG.app.stage/"
    omg_vm_ssh bash -s <"$SCRIPT_DIR/guest-deploy.sh"
}

vm_run() {
    omg_vm_require_running
    omg_vm_ssh "test -d /Applications/OMG.app" ||
        omg_vm_die "OMG Dev is not deployed; run deploy first"

    if ! omg_vm_ssh "pgrep -x omg >/dev/null"; then
        omg_vm_ssh "open -n /Applications/OMG.app --stdout /tmp/omg-stdout.log --stderr /tmp/omg-stderr.log"
    fi

    local attempt
    for attempt in $(seq 1 30); do
        if omg_vm_ssh "pgrep -x omg >/dev/null" 2>/dev/null; then
            break
        fi
        sleep 1
    done
    omg_vm_ssh "pgrep -x omg >/dev/null" || omg_vm_die "OMG Dev did not start; run logs"
    omg_vm_ssh "/usr/bin/osascript -e 'tell application \"System Events\" to tell process \"omg\" to set frontmost to true'"
    echo "OMG Dev is running in the guest"
}

vm_shot() {
    omg_vm_require_running
    local output guest_path
    output="${1:-/tmp/omg-vm-$OMG_VM_NAME-$(date +%Y%m%d-%H%M%S).png}"
    mkdir -p "$(dirname "$output")"
    guest_path="/tmp/omg-vm-shot-$$.png"
    omg_vm_gui /usr/sbin/screencapture -x "$guest_path"
    local ip
    ip="$(omg_vm_ip)"
    omg_vm_scp_from "$ip" "$guest_path" "$output"
    omg_vm_ssh "rm -f '$guest_path'"
    [[ -s "$output" ]] || omg_vm_die "guest screenshot was not created"
    printf '%s\n' "$output"
}

vm_provision() {
    omg_vm_require_running
    omg_vm_ssh "test -d /Applications/OMG.app" ||
        omg_vm_die "OMG Dev is not deployed; run deploy first"
    omg_vm_ssh bash -s <"$SCRIPT_DIR/guest-provision.sh"
}

vm_display() {
    omg_vm_require_running
    omg_vm_scp_to "$(omg_vm_ip)" "$SCRIPT_DIR/guest-display.swift" /tmp/guest-display.swift
    omg_vm_ssh "if [[ ! -x /tmp/omg-display || /tmp/guest-display.swift -nt /tmp/omg-display ]]; then
        swiftc -O /tmp/guest-display.swift -o /tmp/omg-display
    fi"
    if omg_vm_ssh /tmp/omg-display "$@"; then
        if [[ "$1" != list ]]; then
            printf '%s\n' "$1" >"$OMG_VM_DISPLAY_FILE"
        fi
    fi
}

vm_smoke() {
    omg_vm_require_running
    vm_run
    local token output result
    token="$(date +%s)-$$"
    result="$(omg_vm_ssh bash -s -- "$token" <"$SCRIPT_DIR/guest-smoke.sh")"
    [[ "$result" == "OMG_VM_SMOKE_$token" ]] ||
        omg_vm_die "unexpected guest smoke result: $result"

    output="${1:-/tmp/omg-vm-smoke-$OMG_VM_NAME-$token.png}"
    vm_shot "$output" >/dev/null
    printf 'Guest shell round-trip passed: %s\nScreenshot: %s\n' "$result" "$output"
}

vm_desktop() {
    omg_vm_require_running
    omg_vm_ssh "test -d /Applications/OMG.app" ||
        omg_vm_die "OMG Dev is not deployed; run deploy first"

    omg_vm_scp_to "$(omg_vm_ip)" "$SCRIPT_DIR/guest-input.swift" /tmp/guest-input.swift
    omg_vm_ssh "if [[ ! -x /tmp/omg-input || /tmp/guest-input.swift -nt /tmp/omg-input ]]; then
        swiftc -O /tmp/guest-input.swift -o /tmp/omg-input
    fi"
    omg_vm_ssh bash -s <"$SCRIPT_DIR/guest-desktop.sh"
}

vm_xctest() {
    local project="$OMG_VM_REPO_ROOT/macos/Ghostty.xcodeproj"
    local scheme="Ghostty"
    local configuration="Debug"
    local build_dir="$OMG_VM_REPO_ROOT/macos/build"
    local skip_build=false
    local -a build_settings=()
    local -a test_args=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --project) project="${2:?--project requires a path}"; shift 2 ;;
            --scheme) scheme="${2:?--scheme requires a value}"; shift 2 ;;
            --configuration) configuration="${2:?--configuration requires a value}"; shift 2 ;;
            --build-dir) build_dir="${2:?--build-dir requires a path}"; shift 2 ;;
            --build-setting) build_settings+=("${2:?--build-setting requires KEY=VALUE}"); shift 2 ;;
            --skip-build) skip_build=true; shift ;;
            --) shift; test_args+=("$@"); break ;;
            *) test_args+=("$1"); shift ;;
        esac
    done

    if ! $skip_build; then
        rm -f "$build_dir/${scheme}_"*.xctestrun
        env -i \
            HOME="$HOME" \
            PATH="/usr/bin:/bin:/usr/sbin:/sbin" \
            DISABLE_SWIFTLINT=1 \
            xcodebuild \
            -project "$project" \
            -scheme "$scheme" \
            -configuration "$configuration" \
            -skipPackagePluginValidation \
            "SYMROOT=$build_dir" \
            "${build_settings[@]}" \
            build-for-testing
    fi

    local xctestrun
    xctestrun="$(find "$build_dir" -maxdepth 1 -name "${scheme}_*.xctestrun" -print | sort | head -n 1)"
    [[ -n "$xctestrun" && -f "$xctestrun" ]] ||
        omg_vm_die "xctestrun file not found in $build_dir; run without --skip-build first"

    vm_up

    local guest_developer_dir="/Volumes/My Shared Files/Xcode.app/Contents/Developer"
    omg_vm_ssh "test -d '$guest_developer_dir'" ||
        omg_vm_die "host /Applications/Xcode.app is not mounted in guest at $guest_developer_dir"

    local ip guest_test_root="/tmp/omg-xctest-root"
    local guest_config_dir="$guest_test_root/$configuration"
    local guest_xctestrun="$guest_test_root/$(basename "$xctestrun")"
    ip="$(omg_vm_ip)"

    omg_vm_ssh bash -s <<EOF
set -euo pipefail
stamp="/var/db/.omg-xcode-ready-\$(DEVELOPER_DIR='$guest_developer_dir' /usr/bin/xcodebuild -version | tr '\n ' '__')"
if [[ ! -f "\$stamp" ]]; then
    sudo -n DEVELOPER_DIR='$guest_developer_dir' /usr/bin/xcodebuild -license accept
    sudo -n DEVELOPER_DIR='$guest_developer_dir' /usr/bin/xcodebuild -runFirstLaunch
    sudo -n touch "\$stamp"
fi
pkill -x omg 2>/dev/null || true
mkdir -p '$guest_config_dir'
rm -f '$guest_test_root/'*.xctestrun
EOF

    omg_vm_scp_to "$ip" "$xctestrun" "$guest_xctestrun"
    local artifact
    for artifact in OMG.app DockTilePlugin.plugin PackageFrameworks GhosttyUITests-Runner.app; do
        if [[ -e "$build_dir/$configuration/$artifact" ]]; then
            rsync -a --delete -e "ssh ${OMG_VM_SSH_OPTS[*]}" \
                "$build_dir/$configuration/$artifact" "$OMG_VM_USER@$ip:$guest_config_dir/"
        fi
    done

    local guest_host_app="$guest_config_dir/OMG.app"
    if [[ -d "$build_dir/$configuration/OMG.app" ]]; then
        omg_vm_ssh bash -s -- "$guest_host_app" <"$SCRIPT_DIR/guest-provision.sh" >/dev/null
    fi

    local status=0
    omg_vm_gui env \
        DEVELOPER_DIR="$guest_developer_dir" \
        DISABLE_SWIFTLINT=1 \
        /usr/bin/xcodebuild \
        test-without-building \
        -xctestrun "$guest_xctestrun" \
        -destination "platform=macOS,arch=$(uname -m)" \
        "${test_args[@]}" || status=$?

    omg_vm_ssh "pkill -x omg 2>/dev/null || true" >/dev/null 2>&1 || true
    return "$status"
}

vm_logs() {
    omg_vm_require_running
    printf '%s\n' "-- Tart log: $OMG_VM_LOG"
    tail -40 "$OMG_VM_LOG" 2>/dev/null || true
    printf '%s\n' "-- OMG guest logs"
    omg_vm_ssh "for f in /tmp/omg-stdout.log /tmp/omg-stderr.log; do if [ -f \"\$f\" ]; then echo \"--- \$f\"; tail -40 \"\$f\"; fi; done"
}

vm_down() {
    local state attempt offset pid
    state="$(omg_vm_state)"
    if [[ "$state" == suspended ]]; then
        "$OMG_TART" stop "$OMG_VM_NAME"
        launchctl remove "$OMG_VM_LABEL" 2>/dev/null || true
        printf 'VM %s cold-stopped; its disk remains in Tart storage\n' "$OMG_VM_NAME"
        return 0
    fi
    if [[ "$state" != running ]]; then
        launchctl remove "$OMG_VM_LABEL" 2>/dev/null || true
        printf 'VM %s is already %s\n' "$OMG_VM_NAME" "${state:-unknown}"
        return 0
    fi

    offset="$(omg_vm_log_lines)"

    # Ask the guest to halt itself. SSH exits non-zero because the connection
    # drops while the guest shuts down, so the exit status is not meaningful.
    omg_vm_ssh "sudo -n /sbin/shutdown -h now" >/dev/null 2>&1 || true

    for attempt in $(seq 1 45); do
        omg_vm_guest_halted_since "$offset" && break
        sleep 1
    done

    if ! omg_vm_guest_halted_since "$offset"; then
        printf 'Guest did not halt within 45s; forcing %s to stop\n' "$OMG_VM_NAME" >&2
        "$OMG_TART" stop --timeout 15 "$OMG_VM_NAME" >/dev/null 2>&1 || true
    fi

    launchctl remove "$OMG_VM_LABEL" 2>/dev/null || true

    for attempt in $(seq 1 15); do
        state="$(omg_vm_state)"
        [[ "$state" == stopped ]] && break
        sleep 1
    done

    if [[ "$state" != stopped ]]; then
        pid="$(omg_vm_runner_pid)"
        if [[ -n "$pid" ]]; then
            kill "$pid" 2>/dev/null || true
            sleep 3
            state="$(omg_vm_state)"
        fi
    fi

    [[ "$state" == stopped ]] || omg_vm_die "VM '$OMG_VM_NAME' did not stop"
    printf 'VM %s shut down; its disk remains in Tart storage\n' "$OMG_VM_NAME"
}

case "${1:-}" in
    up) shift; [[ $# -eq 0 ]] || omg_vm_die "up takes no arguments"; vm_up ;;
    status) shift; [[ $# -eq 0 ]] || omg_vm_die "status takes no arguments"; vm_status ;;
    deploy) shift; [[ $# -le 1 ]] || omg_vm_die "deploy accepts at most one app path"; vm_deploy "${1:-$OMG_VM_APP}" ;;
    run) shift; [[ $# -eq 0 ]] || omg_vm_die "run takes no arguments"; vm_run ;;
    shot) shift; [[ $# -le 1 ]] || omg_vm_die "shot accepts at most one output path"; vm_shot "${1:-}" ;;
    provision) shift; [[ $# -eq 0 ]] || omg_vm_die "provision takes no arguments"; vm_provision ;;
    display)
        shift
        [[ $# -le 1 ]] || omg_vm_die "display accepts at most one mode"
        if [[ $# -eq 0 ]]; then vm_display list; else vm_display "$1"; fi
        ;;
    smoke) shift; [[ $# -le 1 ]] || omg_vm_die "smoke accepts at most one output path"; vm_smoke "${1:-}" ;;
    desktop) shift; [[ $# -eq 0 ]] || omg_vm_die "desktop takes no arguments"; vm_desktop ;;
    xctest) shift; vm_xctest "$@" ;;
    logs) shift; [[ $# -eq 0 ]] || omg_vm_die "logs takes no arguments"; vm_logs ;;
    down) shift; [[ $# -eq 0 ]] || omg_vm_die "down takes no arguments"; vm_down ;;
    -h|--help|help|"") usage ;;
    *) omg_vm_die "unknown command: $1 (see --help)" ;;
esac
